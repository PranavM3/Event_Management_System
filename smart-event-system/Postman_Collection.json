{
  "info": {
    "name": "Smart Event Registration System",
    "description": "Complete API collection for testing the Smart Event Registration and Feedback Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "registrationId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Organizer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"1234567890\",\n  \"roles\": [\"organizer\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Johnson\",\n  \"email\": \"bob@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\",\n  \"roles\": [\"user\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signin"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"eventId\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Java Spring Boot Workshop\",\n  \"description\": \"Learn Spring Boot fundamentals and build REST APIs\",\n  \"startDateTime\": \"2024-12-15T10:00:00\",\n  \"endDateTime\": \"2024-12-15T16:00:00\",\n  \"location\": \"Computer Lab 101\",\n  \"maxParticipants\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Get Event by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Advanced Java Spring Boot Workshop\",\n  \"description\": \"Deep dive into Spring Boot advanced features\",\n  \"startDateTime\": \"2024-12-15T10:00:00\",\n  \"endDateTime\": \"2024-12-15T17:00:00\",\n  \"location\": \"Computer Lab 102\",\n  \"maxParticipants\": 40\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Get My Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/my-events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "my-events"]
            }
          }
        },
        {
          "name": "Get Events by Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/status/UPCOMING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "status", "UPCOMING"]
            }
          }
        },
        {
          "name": "Update Event Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}/status?status=COMPLETED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "COMPLETED"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"registrationId\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/event/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "event", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Get My Registrations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/my-registrations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "my-registrations"]
            }
          }
        },
        {
          "name": "Get Event Registrations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/event/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "event", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Get Registration by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{registrationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "{{registrationId}}"]
            }
          }
        },
        {
          "name": "Mark Attendance",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{registrationId}}/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "{{registrationId}}", "attendance"]
            }
          }
        },
        {
          "name": "Cancel Registration",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{registrationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "{{registrationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Feedbacks",
      "item": [
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"rating\": 5,\n  \"comment\": \"Excellent workshop! Learned a lot about Spring Boot. The instructor was very knowledgeable and the hands-on exercises were helpful.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/feedbacks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedbacks"]
            }
          }
        },
        {
          "name": "Get Event Feedbacks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/feedbacks/event/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedbacks", "event", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Get My Feedbacks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/feedbacks/my-feedbacks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedbacks", "my-feedbacks"]
            }
          }
        },
        {
          "name": "Get Average Rating",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/feedbacks/event/{{eventId}}/average-rating",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedbacks", "event", "{{eventId}}", "average-rating"]
            }
          }
        },
        {
          "name": "Delete Feedback",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/feedbacks/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedbacks", "1"]
            }
          }
        }
      ]
    }
  ]
}
